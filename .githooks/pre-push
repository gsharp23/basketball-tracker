#!/bin/sh
# Refuses a push unless EVERY file in EVERY commit being pushed is a kind that belongs in git.
# Deleting a file in a later commit does not remove it from history, so the whole history is checked.
allowed='(\.py|\.md)$|^requirements\.txt$|^\.gitignore$|^\.githooks/(pre-commit|pre-push)$|^roster\.example\.json$|\.ipynb$'
linked='^(clips|models|outputs|crops|data)(/|$)'
blank_rosters=" 4873f6ce476a0dfe9485be0e550e79005a73f837 "
empty_file=e69de29bb2d1d6434b8b29ae775ad8c2e48c5391
zero=0000000000000000000000000000000000000000
status=0
while read local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    # every file version reachable from the pushed commit, as "<hash> <path>" (this also sees merges)
    blocked=$(git rev-list --objects "$local_sha" | git cat-file --batch-check='%(objecttype) %(objectname) %(rest)' | sed -n 's/^blob //p' | while read -r sha path; do
        case "$path" in
            roster.json)            # the empty placeholder from the first commit is harmless
                [ "$sha" = "$empty_file" ] || echo "roster.json (it has content)" ;;
            roster.example.json)
                case "$blank_rosters" in *" $sha "*) ;; *) echo "roster.example.json (not the blank template)";; esac ;;
            *.ipynb)
                git cat-file -p "$sha" | grep -q '"image/' && echo "$path (notebook with pictures in its outputs)" ;;
            *)
                if ! echo "$path" | grep -qE "$allowed" || echo "$path" | grep -qE "$linked"; then echo "$path"; fi ;;
        esac
    done; git -c core.quotePath=false log -m --numstat --format= "$local_sha" | awk -F'\t' '$1 == "-" && $2 == "-" {print $3 " (binary)"}')
    blocked=$(echo "$blocked" | sed '/^$/d' | sort -u)
    if [ -n "$blocked" ]; then
        echo "PUSH BLOCKED: the history of $local_ref contains files that must not go to GitHub:"
        echo "$blocked" | sed 's/^/    /'
        status=1
    fi
done
exit $status
