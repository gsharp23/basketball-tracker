#!/bin/sh
# Refuses a push if ANY commit being pushed ever contained photos, video, model files or player names.
# Deleting a file in a later commit does not remove it from history, so the whole history is checked.
pattern='\.(jpe?g|png|gif|bmp|webp|tiff?|heic|mp4|mov|avi|mkv|webm|pt|pth|onnx|npy|npz|zip)$|^(clips|models|outputs|crops|data)(/|$)'
zero=0000000000000000000000000000000000000000
status=0
while read local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    by_name=$(git log --name-only --format= "$local_sha" | sed '/^$/d' | sort -u | grep -iE "$pattern")
    # a roster with real names in it (the empty placeholder from the first commit is harmless)
    roster=$(git log --format=%H "$local_sha" -- roster.json | while read c; do
        [ -n "$(git show "$c:roster.json" 2>/dev/null | tr -d ' \n\t')" ] && echo "roster.json (commit $c)"; done)
    by_content=$(git log --numstat --format= "$local_sha" | awk '$1 == "-" && $2 == "-" {print $3}' | sort -u)
    blocked=$(printf '%s\n%s\n%s\n' "$by_name" "$roster" "$by_content" | sed '/^$/d' | sort -u)
    if [ -n "$blocked" ]; then
        echo "PUSH BLOCKED: the history of $local_ref contains files that must not go to GitHub:"
        echo "$blocked" | sed 's/^/    /'
        status=1
    fi
done
exit $status
