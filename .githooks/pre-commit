#!/bin/sh
# Refuses a commit that contains photos, video, model files, result files, player names or
# any binary file. The players in the footage are minors, so none of that may ever reach GitHub.
pattern='\.(jpe?g|png|gif|bmp|webp|tiff?|heic|mp4|mov|avi|mkv|webm|pt|pth|onnx|npy|npz|zip|csv)$|^(clips|models|outputs|crops|data)(/|$)'
staged=$(git diff --cached --name-only --diff-filter=ACMR)
by_name=$(echo "$staged" | grep -iE "$pattern")
# Results and rosters are JSON files; the blank roster template is the only JSON allowed in git.
by_json=$(echo "$staged" | grep -iE '\.json$' | grep -vxF 'roster.example.json')
# numstat prints "-  -" for binary files, whatever they are called
by_content=$(git diff --cached --numstat --diff-filter=ACMR | awk '$1 == "-" && $2 == "-" {print $3}')
# A notebook saved with its outputs can carry pictures inside it.
by_notebook=$(echo "$staged" | grep -iE '\.ipynb$' | while read -r f; do
    git show ":$f" | grep -q '"image/' && echo "$f  (notebook with pictures in its outputs: clear the outputs first)"; done)
blocked=$(printf '%s\n%s\n%s\n%s\n' "$by_name" "$by_json" "$by_content" "$by_notebook" | sed '/^$/d' | sort -u)
if [ -n "$blocked" ]; then
    echo "COMMIT BLOCKED: these files must not go into git (photos, video, models, results or player names):"
    echo "$blocked" | sed 's/^/    /'
    echo "Unstage them with:  git restore --staged <file>"
    exit 1
fi
