# The players in the footage are minors: no photos, video, results or names ever go to GitHub.
# So this file works as an allow-list: everything is ignored unless it is listed below.
*

# Folders are looked into, but only the file types below are picked up from them.
!*/

# What belongs in git
!*.py
# The dashboard's web pages: text only; the commit guard refuses any embedded picture data
!web/**/*.html
!web/**/*.css
!web/**/*.js
!*.md
!requirements.txt
!.gitignore
!.githooks/pre-commit
!.githooks/pre-push
!roster.example.json
# Notebooks: the commit guard refuses one that still has any saved output
!*.ipynb

# Never, even though they would match a rule above
.venv/
__pycache__/
# Links to the SD card (/mnt/d/hoops-tracker): videos, models, outputs, crops, data
clips
models
outputs
crops
data
